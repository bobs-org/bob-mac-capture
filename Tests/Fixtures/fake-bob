#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${FAKE_BOB_TERM_PATH:-}" ]]; then
  trap 'printf "terminated\n" >"${FAKE_BOB_TERM_PATH}"; exit 143' TERM INT
fi

if [[ -n "${FAKE_BOB_RECORD_PATH:-}" ]]; then
  {
    printf 'argv='
    printf '%s' "$*"
    printf '\n'
    printf 'HOME=%s\n' "${HOME:-}"
    printf 'PATH=%s\n' "${PATH:-}"
    printf 'BOB_DIR=%s\n' "${BOB_DIR:-}"
    printf 'BOB_PRIORITY_ROLL_SEED=%s\n' "${BOB_PRIORITY_ROLL_SEED:-}"
  } >>"${FAKE_BOB_RECORD_PATH}"
fi

if [[ -n "${FAKE_BOB_DELAY_SECONDS:-}" ]]; then
  sleep "${FAKE_BOB_DELAY_SECONDS}" &
  wait $!
fi

if [[ -n "${FAKE_BOB_STDERR:-}" ]]; then
  printf '%s\n' "${FAKE_BOB_STDERR}" >&2
fi

if [[ -n "${FAKE_BOB_STDOUT:-}" ]]; then
  printf '%s\n' "${FAKE_BOB_STDOUT}"
  exit "${FAKE_BOB_EXIT:-0}"
fi

if [[ "${FAKE_BOB_EXIT:-0}" != "0" ]]; then
  exit "${FAKE_BOB_EXIT}"
fi

command="${1:-}"
shift || true

json_string() {
  local value="${1:-}"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '"%s"' "${value}"
}

multiline_draft=$'Prepare launch\n- confirm owner\n- attach checklist'

case "${command}" in
  capture-parse)
    draft="${*: -1}"
    if [[ "${draft}" == *"[[AI"* ]]; then
      prefix="${draft%%"[[AI"*}"
      start=$((${#prefix} + 2))
      end=$((start + 2))
      printf '{"ok":true,"schema_version":1,"input":'
      json_string "${draft}"
      printf ',"body":'
      json_string "${draft}"
      printf ',"mode":"task","needs":[],"spans":[{"start":%s,"end":%s,"kind":"wikilink_target"}],"diagnostics":[]}\n' "${start}" "${end}"
    elif [[ "${draft}" == "idea @ma" ]]; then
      cat <<'JSON'
{
  "ok": true,
  "schema_version": 1,
  "input": "idea @ma",
  "body": "idea",
  "mode": "task",
  "route": "ma",
  "needs": [],
  "spans": [
    { "start": 5, "end": 8, "kind": "route" }
  ],
  "diagnostics": []
}
JSON
    elif [[ "${draft}" == "idea @mac_inbox" ]]; then
      cat <<'JSON'
{
  "ok": true,
  "schema_version": 1,
  "input": "idea @mac_inbox",
  "body": "idea",
  "mode": "task",
  "route": "mac_inbox",
  "needs": [],
  "spans": [
    { "start": 5, "end": 15, "kind": "route" }
  ],
  "diagnostics": [
    { "severity": "info", "code": "accepted_fixture", "message": "Accepted parse refreshed" }
  ]
}
JSON
    elif [[ "${draft}" == "idea @mac_inboxx" ]]; then
      cat <<'JSON'
{
  "ok": true,
  "schema_version": 1,
  "input": "idea @mac_inboxx",
  "body": "idea",
  "mode": "task",
  "route": "mac_inboxx",
  "needs": [],
  "spans": [
    { "start": 5, "end": 16, "kind": "route" }
  ],
  "diagnostics": []
}
JSON
    elif [[ "${draft}" == "Call bank @Cash^" ]]; then
      cat <<'JSON'
{
  "ok": true,
  "schema_version": 1,
  "input": "Call bank @Cash^",
  "body": "Call bank",
  "mode": "incomplete",
  "route": "cash",
  "needs": ["task"],
  "spans": [
    { "start": 10, "end": 15, "kind": "sub_bullet_route" },
    { "start": 15, "end": 16, "kind": "interactive_placeholder" }
  ],
  "diagnostics": []
}
JSON
    elif [[ "${draft}" == "${multiline_draft}" ]]; then
      printf '{"ok":true,"schema_version":1,"input":'
      json_string "${draft}"
      printf ',"body":"Prepare launch","mode":"task","needs":[],"spans":[],"diagnostics":[],'
      printf '"sub_bullets":["confirm owner","attach checklist"]}\n'
    else
      printf '{"ok":true,"schema_version":1,"input":'
      json_string "${draft}"
      printf ',"body":'
      json_string "${draft}"
      printf ',"mode":"task","needs":[],"spans":[],"diagnostics":[]}\n'
    fi
    ;;
  capture-targets)
    cat <<'JSON'
{
  "ok": true,
  "bob_dir": "/tmp/bob",
  "count": 1,
  "targets": [
    {
      "route": "today",
      "name": "today",
      "label": "today.md",
      "kind": "inbox",
      "is_default": true,
      "status": null,
      "relative_path": "today.md"
    }
  ]
}
JSON
    ;;
  capture-complete)
    draft="${*: -1}"
    if [[ "${draft}" == *"[[AI"* ]]; then
      cursor="0"
      args=("$@")
      for ((i = 0; i < ${#args[@]}; i++)); do
        if [[ "${args[$i]}" == "--cursor" || "${args[$i]}" == "-c" ]]; then
          cursor="${args[$((i + 1))]:-0}"
        fi
      done
      prefix="${draft%%"[[AI"*}"
      start=$((${#prefix} + 2))
      end=$((start + 2))
      replacement="Artificial Intelligence|AI]]"
      cursor_after=$((start + ${#replacement}))
      cat <<'JSON'
{
  "ok": true,
  "schema_version": 1,
JSON
      printf '  "cursor": %s,\n' "${cursor}"
      printf '  "replacement": { "start": %s, "end": %s },\n' "${start}" "${end}"
      cat <<'JSON'
  "context": "wikilink_note",
  "candidates": [
    {
      "replacement": "Artificial Intelligence|AI]]",
JSON
      printf '      "cursor_after": %s,\n' "${cursor_after}"
      cat <<'JSON'
      "path": "Artificial Intelligence.md",
      "name": "Artificial Intelligence",
      "alias": "AI",
      "match_kind": "exact_alias"
    }
  ],
  "warnings": ["skipped unreadable note"]
}
JSON
    elif [[ "${draft}" == "idea @ma" ]]; then
      cat <<'JSON'
{
  "ok": true,
  "schema_version": 1,
  "cursor": 8,
  "replacement": { "start": 6, "end": 8 },
  "context": "route",
  "candidates": [
    { "replacement": "mac_inbox", "route": "mac_inbox", "label": "mac_inbox.md", "kind": "inbox", "status": null }
  ]
}
JSON
    elif [[ "${draft}" == "idea @mac_inbox" ]]; then
      cat <<'JSON'
{
  "ok": true,
  "schema_version": 1,
  "cursor": 15,
  "replacement": { "start": 6, "end": 15 },
  "context": "route",
  "candidates": [
    { "replacement": "mac_inbox", "route": "mac_inbox", "label": "mac_inbox.md", "kind": "inbox", "status": null }
  ]
}
JSON
    elif [[ "${draft}" == "idea @mac_inboxx" ]]; then
      cat <<'JSON'
{
  "ok": true,
  "schema_version": 1,
  "cursor": 16,
  "replacement": { "start": 6, "end": 16 },
  "context": "route",
  "candidates": [
    { "replacement": "mac_inbox", "route": "mac_inbox", "label": "mac_inbox.md", "kind": "inbox", "status": null }
  ]
}
JSON
    else
      cat <<'JSON'
{
  "ok": true,
  "schema_version": 1,
  "cursor": 6,
  "replacement": { "start": 6, "end": 6 },
  "context": "route",
  "candidates": [
    { "replacement": "today", "route": "today", "label": "today.md", "kind": "inbox", "status": null }
  ]
}
JSON
    fi
    ;;
  capture)
    dry_run="false"
    for arg in "$@"; do
      if [[ "${arg}" == "--dry-run" ]]; then
        dry_run="true"
      fi
    done
    draft="${*: -1}"
    if [[ "${draft}" == "idea @mac_inbox" ]]; then
      cat <<JSON
{
  "ok": true,
  "dry_run": ${dry_run},
  "routed": true,
  "route": "mac_inbox",
  "route_label": "mac_inbox.md",
  "relative_target": "mac_inbox.md",
  "target": "/tmp/bob/mac_inbox.md",
  "text": "idea",
  "task_line": "- [ ] #task accepted completion [created::2026-08-14]",
  "kind": "task",
  "created": "2026-08-14",
  "scheduled": null,
  "placement": "inserted"
}
JSON
    elif [[ "${draft}" == "${multiline_draft}" ]]; then
      cat <<JSON
{
  "ok": true,
  "dry_run": ${dry_run},
  "routed": true,
  "route": "cash",
  "route_label": "cash.md",
  "relative_target": "cash.md",
  "target": "/tmp/bob/cash.md",
  "text": "Prepare launch",
  "task_line": "- [ ] #task Prepare launch [created::2026-08-14]",
  "kind": "task",
  "created": "2026-08-14",
  "scheduled": null,
  "placement": "inserted",
  "sub_bullets": ["  - confirm owner", "  - attach checklist"]
}
JSON
    else
      cat <<JSON
{
  "ok": true,
  "dry_run": ${dry_run},
  "routed": true,
  "route": "cash",
  "route_label": "cash.md",
  "relative_target": "cash.md",
  "target": "/tmp/bob/cash.md",
  "text": "captured",
  "task_line": "- [ ] #task captured [created::2026-08-14]",
  "kind": "task",
  "created": "2026-08-14",
  "scheduled": null,
  "placement": "inserted"
}
JSON
    fi
    ;;
  *)
    printf 'unknown fake command: %s\n' "${command}" >&2
    exit 64
    ;;
esac
